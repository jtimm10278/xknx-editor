msgid ""
msgstr ""
"Project-Id-Version: xknx-editor assistant 1.0\n"
"Language: ro\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "AI Assistant"
msgstr "Asistent IA"

msgid "Ask about the open project. The assistant looks things up with the editor's own tools and never uses the bus."
msgstr "Întrebați despre proiectul deschis. Asistentul caută cu instrumentele editorului și nu folosește niciodată magistrala."

msgid "Ask about the open project…"
msgstr "Întrebați despre proiectul deschis…"

msgid "Send"
msgstr "Trimite"

msgid "Stop"
msgstr "Oprește"

msgid "New Conversation"
msgstr "Conversație nouă"

msgid "Allow Changes"
msgstr "Permite modificări"

msgid "The assistant may then change the project; Edit > Undo takes each change back. It never deletes, exports, programs devices or uses the bus."
msgstr "Asistentul poate atunci modifica proiectul; Editare > Anulare anulează fiecare modificare. Nu șterge, nu exportă, nu programează dispozitive și nu folosește niciodată magistrala."

msgid "Working…"
msgstr "Lucrează…"

msgid "You"
msgstr "Dvs."

msgid "Used: {tool}"
msgstr "Folosit: {tool}"

msgid "What the assistant reads in the project is sent to {provider}."
msgstr "Ce citește asistentul din proiect este trimis la {provider}."

msgid "Choose an AI provider and enter your API key in the settings first."
msgstr "Alegeți mai întâi un furnizor IA și introduceți cheia API în setări."

msgid "Open Settings"
msgstr "Deschide setările"

msgid "Allow Changes was switched: a new conversation started."
msgstr "„Permite modificări” a fost comutat: a început o conversație nouă."

msgid "Stopped."
msgstr "Oprit."

msgid "No API key is set."
msgstr "Nu este setată nicio cheie API."

msgid "No model is set."
msgstr "Nu este setat niciun model."

msgid "No API address is set."
msgstr "Nu este setată nicio adresă API."

msgid "The provider did not accept the API key."
msgstr "Furnizorul nu a acceptat cheia API."

msgid "The provider's rate limit was reached; try again shortly."
msgstr "S-a atins limita de cereri a furnizorului; încercați din nou în curând."

msgid "The provider answered with an error."
msgstr "Furnizorul a răspuns cu o eroare."

msgid "The provider could not be reached."
msgstr "Furnizorul nu poate fi contactat."

msgid "The provider's answer could not be read."
msgstr "Răspunsul furnizorului nu poate fi citit."

msgid "The model declined to answer this."
msgstr "Modelul a refuzat să răspundă."

msgid "The answer was cut off because it was too long."
msgstr "Răspunsul a fost tăiat pentru că era prea lung."

msgid "Stopped after {count} steps without an answer."
msgstr "Oprit după {count} pași fără răspuns."

msgid "The assistant failed."
msgstr "Asistentul a eșuat."

msgid "The AI Assistant uses an AI provider of your choice with your own API key. The provider bills its use; a chat subscription (such as Claude Pro or ChatGPT Plus) does not include it."
msgstr "Asistentul IA folosește un furnizor IA ales de dvs., cu propria cheie API. Furnizorul facturează utilizarea; un abonament de chat (de ex. Claude Pro sau ChatGPT Plus) nu o include."

msgid "Provider"
msgstr "Furnizor"

msgid "Other (OpenAI-compatible)"
msgstr "Altul (compatibil OpenAI)"

msgid "Model"
msgstr "Model"

msgid "The model's name as the provider lists it. Empty: {model}."
msgstr "Numele modelului așa cum îl indică furnizorul. Gol: {model}."

msgid "The model's name as the provider lists it."
msgstr "Numele modelului așa cum îl indică furnizorul."

msgid "API Key"
msgstr "Cheie API"

msgid "From the provider's developer console. It is kept in the editor's settings on this computer."
msgstr "Din consola pentru dezvoltatori a furnizorului. Este păstrată în setările editorului pe acest calculator."

msgid "API Address"
msgstr "Adresă API"

msgid "Empty: the provider's own address. Needed for Other."
msgstr "Gol: adresa proprie a furnizorului. Necesară pentru „Altul”."
