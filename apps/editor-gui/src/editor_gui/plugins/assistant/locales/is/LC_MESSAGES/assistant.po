msgid ""
msgstr ""
"Project-Id-Version: xknx-editor assistant 1.0\n"
"Language: is\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "AI Assistant"
msgstr "Gervigreindaraðstoð"

msgid "Ask about the open project. The assistant looks things up with the editor's own tools and never uses the bus."
msgstr "Spurðu um opna verkefnið. Aðstoðin flettir upp með eigin verkfærum ritilsins og notar aldrei strætóinn."

msgid "Ask about the open project…"
msgstr "Spurðu um opna verkefnið…"

msgid "Send"
msgstr "Senda"

msgid "Stop"
msgstr "Stöðva"

msgid "New Conversation"
msgstr "Nýtt samtal"

msgid "Allow Changes"
msgstr "Leyfa breytingar"

msgid "The assistant may then change the project; Edit > Undo takes each change back. It never deletes, exports, programs devices or uses the bus."
msgstr "Aðstoðin má þá breyta verkefninu; Breyta > Afturkalla tekur hverja breytingu til baka. Hún eyðir aldrei, flytur ekki út, forritar ekki tæki og notar aldrei strætóinn."

msgid "Working…"
msgstr "Vinnur…"

msgid "You"
msgstr "Þú"

msgid "Used: {tool}"
msgstr "Notað: {tool}"

msgid "What the assistant reads in the project is sent to {provider}."
msgstr "Það sem aðstoðin les í verkefninu er sent til {provider}."

msgid "Choose an AI provider and enter your API key in the settings first."
msgstr "Veldu fyrst gervigreindarþjónustu og sláðu inn API-lykilinn þinn í stillingunum."

msgid "Open Settings"
msgstr "Opna stillingar"

msgid "Allow Changes was switched: a new conversation started."
msgstr "„Leyfa breytingar“ var breytt: nýtt samtal hófst."

msgid "Stopped."
msgstr "Stöðvað."

msgid "No API key is set."
msgstr "Enginn API-lykill skráður."

msgid "No model is set."
msgstr "Ekkert líkan skráð."

msgid "No API address is set."
msgstr "Ekkert API-vistfang skráð."

msgid "The provider did not accept the API key."
msgstr "Þjónustan samþykkti ekki API-lykilinn."

msgid "The provider's rate limit was reached; try again shortly."
msgstr "Beiðnamörkum þjónustunnar er náð; reyndu aftur innan skamms."

msgid "The provider answered with an error."
msgstr "Þjónustan svaraði með villu."

msgid "The provider could not be reached."
msgstr "Ekki náðist í þjónustuna."

msgid "The provider's answer could not be read."
msgstr "Ekki tókst að lesa svar þjónustunnar."

msgid "The model declined to answer this."
msgstr "Líkanið neitaði að svara."

msgid "The answer was cut off because it was too long."
msgstr "Svarið var stytt því það var of langt."

msgid "Stopped after {count} steps without an answer."
msgstr "Stöðvað eftir {count} skref án svars."

msgid "The assistant failed."
msgstr "Aðstoðin brást."

msgid "The AI Assistant uses an AI provider of your choice with your own API key. The provider bills its use; a chat subscription (such as Claude Pro or ChatGPT Plus) does not include it."
msgstr "Gervigreindaraðstoðin notar gervigreindarþjónustu að eigin vali með þínum eigin API-lykli. Þjónustan rukkar fyrir notkunina; spjallaskrift (eins og Claude Pro eða ChatGPT Plus) nær ekki yfir hana."

msgid "Provider"
msgstr "Þjónusta"

msgid "Other (OpenAI-compatible)"
msgstr "Önnur (samhæfð OpenAI)"

msgid "Model"
msgstr "Líkan"

msgid "The model's name as the provider lists it. Empty: {model}."
msgstr "Heiti líkansins eins og þjónustan gefur það upp. Autt: {model}."

msgid "The model's name as the provider lists it."
msgstr "Heiti líkansins eins og þjónustan gefur það upp."

msgid "API Key"
msgstr "API-lykill"

msgid "From the provider's developer console. It is kept in the editor's settings on this computer."
msgstr "Úr forritarastjórnborði þjónustunnar. Hann er geymdur í stillingum ritilsins á þessari tölvu."

msgid "API Address"
msgstr "API-vistfang"

msgid "Empty: the provider's own address. Needed for Other."
msgstr "Autt: eigið vistfang þjónustunnar. Nauðsynlegt fyrir „Önnur“."
