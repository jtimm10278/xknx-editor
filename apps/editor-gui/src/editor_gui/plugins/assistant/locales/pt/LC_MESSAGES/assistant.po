msgid ""
msgstr ""
"Project-Id-Version: xknx-editor assistant 1.0\n"
"Language: pt\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "AI Assistant"
msgstr "Assistente de IA"

msgid "Ask about the open project. The assistant looks things up with the editor's own tools and never uses the bus."
msgstr "Pergunte sobre o projeto aberto. O assistente pesquisa com as ferramentas do próprio editor e nunca usa o barramento."

msgid "Ask about the open project…"
msgstr "Pergunte sobre o projeto aberto…"

msgid "Send"
msgstr "Enviar"

msgid "Stop"
msgstr "Parar"

msgid "New Conversation"
msgstr "Nova conversa"

msgid "Allow Changes"
msgstr "Permitir alterações"

msgid "The assistant may then change the project; Edit > Undo takes each change back. It never deletes, exports, programs devices or uses the bus."
msgstr "O assistente pode então alterar o projeto; Editar > Anular desfaz cada alteração. Nunca elimina, exporta, programa dispositivos nem usa o barramento."

msgid "Working…"
msgstr "A trabalhar…"

msgid "You"
msgstr "Você"

msgid "Used: {tool}"
msgstr "Usado: {tool}"

msgid "What the assistant reads in the project is sent to {provider}."
msgstr "O que o assistente lê no projeto é enviado para {provider}."

msgid "Choose an AI provider and enter your API key in the settings first."
msgstr "Escolha primeiro um fornecedor de IA e introduza a sua chave de API nas configurações."

msgid "Open Settings"
msgstr "Abrir configurações"

msgid "Allow Changes was switched: a new conversation started."
msgstr "«Permitir alterações» foi mudado: começou uma nova conversa."

msgid "Stopped."
msgstr "Parado."

msgid "No API key is set."
msgstr "Nenhuma chave de API definida."

msgid "No model is set."
msgstr "Nenhum modelo definido."

msgid "No API address is set."
msgstr "Nenhum endereço de API definido."

msgid "The provider did not accept the API key."
msgstr "O fornecedor não aceitou a chave de API."

msgid "The provider's rate limit was reached; try again shortly."
msgstr "Foi atingido o limite de pedidos do fornecedor; tente de novo daqui a pouco."

msgid "The provider answered with an error."
msgstr "O fornecedor respondeu com um erro."

msgid "The provider could not be reached."
msgstr "Não foi possível contactar o fornecedor."

msgid "The provider's answer could not be read."
msgstr "Não foi possível ler a resposta do fornecedor."

msgid "The model declined to answer this."
msgstr "O modelo recusou-se a responder."

msgid "The answer was cut off because it was too long."
msgstr "A resposta foi cortada por ser demasiado longa."

msgid "Stopped after {count} steps without an answer."
msgstr "Parado após {count} passos sem resposta."

msgid "The assistant failed."
msgstr "O assistente falhou."

msgid "The AI Assistant uses an AI provider of your choice with your own API key. The provider bills its use; a chat subscription (such as Claude Pro or ChatGPT Plus) does not include it."
msgstr "O assistente de IA usa um fornecedor de IA à sua escolha com a sua própria chave de API. O fornecedor fatura a utilização; uma subscrição de chat (como Claude Pro ou ChatGPT Plus) não a inclui."

msgid "Provider"
msgstr "Fornecedor"

msgid "Other (OpenAI-compatible)"
msgstr "Outro (compatível com OpenAI)"

msgid "Model"
msgstr "Modelo"

msgid "The model's name as the provider lists it. Empty: {model}."
msgstr "O nome do modelo tal como o fornecedor o indica. Vazio: {model}."

msgid "The model's name as the provider lists it."
msgstr "O nome do modelo tal como o fornecedor o indica."

msgid "API Key"
msgstr "Chave de API"

msgid "From the provider's developer console. It is kept in the editor's settings on this computer."
msgstr "Da consola de programador do fornecedor. Fica guardada nas configurações do editor neste computador."

msgid "API Address"
msgstr "Endereço de API"

msgid "Empty: the provider's own address. Needed for Other."
msgstr "Vazio: o endereço próprio do fornecedor. Necessário para «Outro»."
