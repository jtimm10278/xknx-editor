msgid ""
msgstr ""
"Project-Id-Version: xknx-editor assistant 1.0\n"
"Language: cs\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "AI Assistant"
msgstr "AI asistent"

msgid "Ask about the open project. The assistant looks things up with the editor's own tools and never uses the bus."
msgstr "Ptejte se na otevřený projekt. Asistent vyhledává nástroji editoru a nikdy nepoužívá sběrnici."

msgid "Ask about the open project…"
msgstr "Zeptejte se na otevřený projekt…"

msgid "Send"
msgstr "Odeslat"

msgid "Stop"
msgstr "Zastavit"

msgid "New Conversation"
msgstr "Nová konverzace"

msgid "Allow Changes"
msgstr "Povolit změny"

msgid "The assistant may then change the project; Edit > Undo takes each change back. It never deletes, exports, programs devices or uses the bus."
msgstr "Asistent pak smí měnit projekt; Úpravy > Zpět vrátí každou změnu. Nikdy nemaže, neexportuje, neprogramuje zařízení a nepoužívá sběrnici."

msgid "Working…"
msgstr "Pracuje…"

msgid "You"
msgstr "Vy"

msgid "Used: {tool}"
msgstr "Použito: {tool}"

msgid "What the assistant reads in the project is sent to {provider}."
msgstr "Co asistent v projektu čte, se odesílá do {provider}."

msgid "Choose an AI provider and enter your API key in the settings first."
msgstr "Nejprve v nastavení zvolte poskytovatele AI a zadejte svůj klíč API."

msgid "Open Settings"
msgstr "Otevřít nastavení"

msgid "Allow Changes was switched: a new conversation started."
msgstr "„Povolit změny“ bylo přepnuto: začala nová konverzace."

msgid "Stopped."
msgstr "Zastaveno."

msgid "No API key is set."
msgstr "Není nastaven klíč API."

msgid "No model is set."
msgstr "Není nastaven model."

msgid "No API address is set."
msgstr "Není nastavena adresa API."

msgid "The provider did not accept the API key."
msgstr "Poskytovatel nepřijal klíč API."

msgid "The provider's rate limit was reached; try again shortly."
msgstr "Byl dosažen limit požadavků poskytovatele; zkuste to za chvíli znovu."

msgid "The provider answered with an error."
msgstr "Poskytovatel odpověděl chybou."

msgid "The provider could not be reached."
msgstr "Poskytovatele nelze zastihnout."

msgid "The provider's answer could not be read."
msgstr "Odpověď poskytovatele nelze přečíst."

msgid "The model declined to answer this."
msgstr "Model odmítl odpovědět."

msgid "The answer was cut off because it was too long."
msgstr "Odpověď byla zkrácena, protože byla příliš dlouhá."

msgid "Stopped after {count} steps without an answer."
msgstr "Zastaveno po {count} krocích bez odpovědi."

msgid "The assistant failed."
msgstr "Asistent selhal."

msgid "The AI Assistant uses an AI provider of your choice with your own API key. The provider bills its use; a chat subscription (such as Claude Pro or ChatGPT Plus) does not include it."
msgstr "AI asistent používá poskytovatele AI dle vaší volby s vaším vlastním klíčem API. Poskytovatel účtuje použití; předplatné chatu (např. Claude Pro nebo ChatGPT Plus) jej nezahrnuje."

msgid "Provider"
msgstr "Poskytovatel"

msgid "Other (OpenAI-compatible)"
msgstr "Jiný (kompatibilní s OpenAI)"

msgid "Model"
msgstr "Model"

msgid "The model's name as the provider lists it. Empty: {model}."
msgstr "Název modelu, jak jej uvádí poskytovatel. Prázdné: {model}."

msgid "The model's name as the provider lists it."
msgstr "Název modelu, jak jej uvádí poskytovatel."

msgid "API Key"
msgstr "Klíč API"

msgid "From the provider's developer console. It is kept in the editor's settings on this computer."
msgstr "Z vývojářské konzole poskytovatele. Ukládá se v nastavení editoru na tomto počítači."

msgid "API Address"
msgstr "Adresa API"

msgid "Empty: the provider's own address. Needed for Other."
msgstr "Prázdné: vlastní adresa poskytovatele. Nutné pro „Jiný“."
