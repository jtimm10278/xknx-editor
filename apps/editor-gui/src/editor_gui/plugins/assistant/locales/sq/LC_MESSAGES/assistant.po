msgid ""
msgstr ""
"Project-Id-Version: xknx-editor assistant 1.0\n"
"Language: sq\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "AI Assistant"
msgstr "Asistenti IA"

msgid "Ask about the open project. The assistant looks things up with the editor's own tools and never uses the bus."
msgstr "Pyetni për projektin e hapur. Asistenti kërkon me mjetet e vetë redaktorit dhe nuk përdor kurrë bus-in."

msgid "Ask about the open project…"
msgstr "Pyetni për projektin e hapur…"

msgid "Send"
msgstr "Dërgo"

msgid "Stop"
msgstr "Ndalo"

msgid "New Conversation"
msgstr "Bisedë e re"

msgid "Allow Changes"
msgstr "Lejo ndryshimet"

msgid "The assistant may then change the project; Edit > Undo takes each change back. It never deletes, exports, programs devices or uses the bus."
msgstr "Asistenti mund ta ndryshojë atëherë projektin; Ndrysho > Zhbëj kthen çdo ndryshim. Nuk fshin, nuk eksporton, nuk programon pajisje dhe nuk përdor kurrë bus-in."

msgid "Working…"
msgstr "Po punon…"

msgid "You"
msgstr "Ju"

msgid "Used: {tool}"
msgstr "U përdor: {tool}"

msgid "What the assistant reads in the project is sent to {provider}."
msgstr "Çfarë lexon asistenti në projekt i dërgohet {provider}."

msgid "Choose an AI provider and enter your API key in the settings first."
msgstr "Zgjidhni fillimisht një ofrues IA dhe vendosni çelësin tuaj API te cilësimet."

msgid "Open Settings"
msgstr "Hap cilësimet"

msgid "Allow Changes was switched: a new conversation started."
msgstr "\"Lejo ndryshimet\" u ndryshua: nisi një bisedë e re."

msgid "Stopped."
msgstr "U ndal."

msgid "No API key is set."
msgstr "Nuk është vendosur çelës API."

msgid "No model is set."
msgstr "Nuk është vendosur model."

msgid "No API address is set."
msgstr "Nuk është vendosur adresë API."

msgid "The provider did not accept the API key."
msgstr "Ofruesi nuk e pranoi çelësin API."

msgid "The provider's rate limit was reached; try again shortly."
msgstr "U arrit kufiri i kërkesave të ofruesit; provoni sërish pas pak."

msgid "The provider answered with an error."
msgstr "Ofruesi u përgjigj me një gabim."

msgid "The provider could not be reached."
msgstr "Ofruesi nuk mund të arrihej."

msgid "The provider's answer could not be read."
msgstr "Përgjigjja e ofruesit nuk mund të lexohej."

msgid "The model declined to answer this."
msgstr "Modeli refuzoi të përgjigjej."

msgid "The answer was cut off because it was too long."
msgstr "Përgjigjja u shkurtua sepse ishte shumë e gjatë."

msgid "Stopped after {count} steps without an answer."
msgstr "U ndal pas {count} hapash pa përgjigje."

msgid "The assistant failed."
msgstr "Asistenti dështoi."

msgid "The AI Assistant uses an AI provider of your choice with your own API key. The provider bills its use; a chat subscription (such as Claude Pro or ChatGPT Plus) does not include it."
msgstr "Asistenti IA përdor një ofrues IA sipas zgjedhjes suaj me çelësin tuaj API. Ofruesi faturon përdorimin; një abonim bisede (si Claude Pro ose ChatGPT Plus) nuk e përfshin."

msgid "Provider"
msgstr "Ofruesi"

msgid "Other (OpenAI-compatible)"
msgstr "Tjetër (i përputhshëm me OpenAI)"

msgid "Model"
msgstr "Modeli"

msgid "The model's name as the provider lists it. Empty: {model}."
msgstr "Emri i modelit siç e jep ofruesi. Bosh: {model}."

msgid "The model's name as the provider lists it."
msgstr "Emri i modelit siç e jep ofruesi."

msgid "API Key"
msgstr "Çelësi API"

msgid "From the provider's developer console. It is kept in the editor's settings on this computer."
msgstr "Nga konsola e zhvilluesit e ofruesit. Ruhet te cilësimet e redaktorit në këtë kompjuter."

msgid "API Address"
msgstr "Adresa API"

msgid "Empty: the provider's own address. Needed for Other."
msgstr "Bosh: adresa e vetë ofruesit. E nevojshme për \"Tjetër\"."
