msgid ""
msgstr ""
"Project-Id-Version: xknx-editor assistant 1.0\n"
"Language: sk\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "AI Assistant"
msgstr "AI asistent"

msgid "Ask about the open project. The assistant looks things up with the editor's own tools and never uses the bus."
msgstr "Pýtajte sa na otvorený projekt. Asistent vyhľadáva nástrojmi editora a nikdy nepoužíva zbernicu."

msgid "Ask about the open project…"
msgstr "Opýtajte sa na otvorený projekt…"

msgid "Send"
msgstr "Odoslať"

msgid "Stop"
msgstr "Zastaviť"

msgid "New Conversation"
msgstr "Nová konverzácia"

msgid "Allow Changes"
msgstr "Povoliť zmeny"

msgid "The assistant may then change the project; Edit > Undo takes each change back. It never deletes, exports, programs devices or uses the bus."
msgstr "Asistent potom smie meniť projekt; Upraviť > Späť vráti každú zmenu. Nikdy nemaže, neexportuje, neprogramuje zariadenia a nepoužíva zbernicu."

msgid "Working…"
msgstr "Pracuje…"

msgid "You"
msgstr "Vy"

msgid "Used: {tool}"
msgstr "Použité: {tool}"

msgid "What the assistant reads in the project is sent to {provider}."
msgstr "Čo asistent v projekte číta, sa odosiela do {provider}."

msgid "Choose an AI provider and enter your API key in the settings first."
msgstr "Najprv v nastaveniach zvoľte poskytovateľa AI a zadajte svoj kľúč API."

msgid "Open Settings"
msgstr "Otvoriť nastavenia"

msgid "Allow Changes was switched: a new conversation started."
msgstr "„Povoliť zmeny“ sa prepli: začala sa nová konverzácia."

msgid "Stopped."
msgstr "Zastavené."

msgid "No API key is set."
msgstr "Nie je nastavený kľúč API."

msgid "No model is set."
msgstr "Nie je nastavený model."

msgid "No API address is set."
msgstr "Nie je nastavená adresa API."

msgid "The provider did not accept the API key."
msgstr "Poskytovateľ neprijal kľúč API."

msgid "The provider's rate limit was reached; try again shortly."
msgstr "Dosiahol sa limit požiadaviek poskytovateľa; skúste to o chvíľu znova."

msgid "The provider answered with an error."
msgstr "Poskytovateľ odpovedal chybou."

msgid "The provider could not be reached."
msgstr "Poskytovateľ je nedostupný."

msgid "The provider's answer could not be read."
msgstr "Odpoveď poskytovateľa sa nedá prečítať."

msgid "The model declined to answer this."
msgstr "Model odmietol odpovedať."

msgid "The answer was cut off because it was too long."
msgstr "Odpoveď bola skrátená, pretože bola príliš dlhá."

msgid "Stopped after {count} steps without an answer."
msgstr "Zastavené po {count} krokoch bez odpovede."

msgid "The assistant failed."
msgstr "Asistent zlyhal."

msgid "The AI Assistant uses an AI provider of your choice with your own API key. The provider bills its use; a chat subscription (such as Claude Pro or ChatGPT Plus) does not include it."
msgstr "AI asistent používa poskytovateľa AI podľa vášho výberu s vaším vlastným kľúčom API. Poskytovateľ účtuje používanie; predplatné chatu (napr. Claude Pro alebo ChatGPT Plus) ho nezahŕňa."

msgid "Provider"
msgstr "Poskytovateľ"

msgid "Other (OpenAI-compatible)"
msgstr "Iný (kompatibilný s OpenAI)"

msgid "Model"
msgstr "Model"

msgid "The model's name as the provider lists it. Empty: {model}."
msgstr "Názov modelu, ako ho uvádza poskytovateľ. Prázdne: {model}."

msgid "The model's name as the provider lists it."
msgstr "Názov modelu, ako ho uvádza poskytovateľ."

msgid "API Key"
msgstr "Kľúč API"

msgid "From the provider's developer console. It is kept in the editor's settings on this computer."
msgstr "Z vývojárskej konzoly poskytovateľa. Ukladá sa v nastaveniach editora na tomto počítači."

msgid "API Address"
msgstr "Adresa API"

msgid "Empty: the provider's own address. Needed for Other."
msgstr "Prázdne: vlastná adresa poskytovateľa. Potrebné pre „Iný“."
