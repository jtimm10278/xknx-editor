msgid ""
msgstr ""
"Project-Id-Version: xknx-editor assistant 1.0\n"
"Language: nb\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "AI Assistant"
msgstr "KI-assistent"

msgid "Ask about the open project. The assistant looks things up with the editor's own tools and never uses the bus."
msgstr "Spør om det åpne prosjektet. Assistenten slår opp med redigeringsprogrammets egne verktøy og bruker aldri bussen."

msgid "Ask about the open project…"
msgstr "Spør om det åpne prosjektet…"

msgid "Send"
msgstr "Send"

msgid "Stop"
msgstr "Stopp"

msgid "New Conversation"
msgstr "Ny samtale"

msgid "Allow Changes"
msgstr "Tillat endringer"

msgid "The assistant may then change the project; Edit > Undo takes each change back. It never deletes, exports, programs devices or uses the bus."
msgstr "Assistenten kan da endre prosjektet; Rediger > Angre tar hver endring tilbake. Den sletter, eksporterer og programmerer aldri og bruker aldri bussen."

msgid "Working…"
msgstr "Arbeider…"

msgid "You"
msgstr "Du"

msgid "Used: {tool}"
msgstr "Brukt: {tool}"

msgid "What the assistant reads in the project is sent to {provider}."
msgstr "Det assistenten leser i prosjektet, sendes til {provider}."

msgid "Choose an AI provider and enter your API key in the settings first."
msgstr "Velg først en KI-leverandør og skriv inn API-nøkkelen din i innstillingene."

msgid "Open Settings"
msgstr "Åpne innstillinger"

msgid "Allow Changes was switched: a new conversation started."
msgstr "«Tillat endringer» ble endret: en ny samtale har startet."

msgid "Stopped."
msgstr "Stoppet."

msgid "No API key is set."
msgstr "Ingen API-nøkkel angitt."

msgid "No model is set."
msgstr "Ingen modell angitt."

msgid "No API address is set."
msgstr "Ingen API-adresse angitt."

msgid "The provider did not accept the API key."
msgstr "Leverandøren godtok ikke API-nøkkelen."

msgid "The provider's rate limit was reached; try again shortly."
msgstr "Leverandørens grense for forespørsler er nådd; prøv igjen om litt."

msgid "The provider answered with an error."
msgstr "Leverandøren svarte med en feil."

msgid "The provider could not be reached."
msgstr "Leverandøren kunne ikke nås."

msgid "The provider's answer could not be read."
msgstr "Leverandørens svar kunne ikke leses."

msgid "The model declined to answer this."
msgstr "Modellen avslo å svare."

msgid "The answer was cut off because it was too long."
msgstr "Svaret ble kuttet fordi det var for langt."

msgid "Stopped after {count} steps without an answer."
msgstr "Stoppet etter {count} trinn uten svar."

msgid "The assistant failed."
msgstr "Assistenten mislyktes."

msgid "The AI Assistant uses an AI provider of your choice with your own API key. The provider bills its use; a chat subscription (such as Claude Pro or ChatGPT Plus) does not include it."
msgstr "KI-assistenten bruker en KI-leverandør du velger, med din egen API-nøkkel. Leverandøren fakturerer bruken; et chatabonnement (som Claude Pro eller ChatGPT Plus) dekker det ikke."

msgid "Provider"
msgstr "Leverandør"

msgid "Other (OpenAI-compatible)"
msgstr "Annen (OpenAI-kompatibel)"

msgid "Model"
msgstr "Modell"

msgid "The model's name as the provider lists it. Empty: {model}."
msgstr "Modellens navn slik leverandøren oppgir det. Tom: {model}."

msgid "The model's name as the provider lists it."
msgstr "Modellens navn slik leverandøren oppgir det."

msgid "API Key"
msgstr "API-nøkkel"

msgid "From the provider's developer console. It is kept in the editor's settings on this computer."
msgstr "Fra leverandørens utviklerkonsoll. Den lagres i redigeringsprogrammets innstillinger på denne datamaskinen."

msgid "API Address"
msgstr "API-adresse"

msgid "Empty: the provider's own address. Needed for Other."
msgstr "Tom: leverandørens egen adresse. Nødvendig for «Annen»."
