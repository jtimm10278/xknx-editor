msgid ""
msgstr ""
"Project-Id-Version: xknx-editor assistant 1.0\n"
"Language: pl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "AI Assistant"
msgstr "Asystent AI"

msgid "Ask about the open project. The assistant looks things up with the editor's own tools and never uses the bus."
msgstr "Pytaj o otwarty projekt. Asystent wyszukuje za pomocą narzędzi edytora i nigdy nie używa magistrali."

msgid "Ask about the open project…"
msgstr "Zapytaj o otwarty projekt…"

msgid "Send"
msgstr "Wyślij"

msgid "Stop"
msgstr "Zatrzymaj"

msgid "New Conversation"
msgstr "Nowa rozmowa"

msgid "Allow Changes"
msgstr "Zezwól na zmiany"

msgid "The assistant may then change the project; Edit > Undo takes each change back. It never deletes, exports, programs devices or uses the bus."
msgstr "Asystent może wtedy zmieniać projekt; Edycja > Cofnij wycofuje każdą zmianę. Nigdy nie usuwa, nie eksportuje, nie programuje urządzeń ani nie używa magistrali."

msgid "Working…"
msgstr "Pracuje…"

msgid "You"
msgstr "Ty"

msgid "Used: {tool}"
msgstr "Użyto: {tool}"

msgid "What the assistant reads in the project is sent to {provider}."
msgstr "To, co asystent odczytuje z projektu, jest wysyłane do {provider}."

msgid "Choose an AI provider and enter your API key in the settings first."
msgstr "Najpierw wybierz dostawcę AI i wpisz swój klucz API w ustawieniach."

msgid "Open Settings"
msgstr "Otwórz ustawienia"

msgid "Allow Changes was switched: a new conversation started."
msgstr "Przełączono „Zezwól na zmiany”: rozpoczęto nową rozmowę."

msgid "Stopped."
msgstr "Zatrzymano."

msgid "No API key is set."
msgstr "Nie ustawiono klucza API."

msgid "No model is set."
msgstr "Nie ustawiono modelu."

msgid "No API address is set."
msgstr "Nie ustawiono adresu API."

msgid "The provider did not accept the API key."
msgstr "Dostawca nie zaakceptował klucza API."

msgid "The provider's rate limit was reached; try again shortly."
msgstr "Osiągnięto limit zapytań dostawcy; spróbuj ponownie za chwilę."

msgid "The provider answered with an error."
msgstr "Dostawca odpowiedział błędem."

msgid "The provider could not be reached."
msgstr "Nie można połączyć się z dostawcą."

msgid "The provider's answer could not be read."
msgstr "Nie można odczytać odpowiedzi dostawcy."

msgid "The model declined to answer this."
msgstr "Model odmówił odpowiedzi."

msgid "The answer was cut off because it was too long."
msgstr "Odpowiedź została ucięta, ponieważ była za długa."

msgid "Stopped after {count} steps without an answer."
msgstr "Zatrzymano po {count} krokach bez odpowiedzi."

msgid "The assistant failed."
msgstr "Asystent zawiódł."

msgid "The AI Assistant uses an AI provider of your choice with your own API key. The provider bills its use; a chat subscription (such as Claude Pro or ChatGPT Plus) does not include it."
msgstr "Asystent AI korzysta z wybranego dostawcy AI z Twoim własnym kluczem API. Dostawca nalicza opłaty za użycie; subskrypcja czatu (np. Claude Pro lub ChatGPT Plus) go nie obejmuje."

msgid "Provider"
msgstr "Dostawca"

msgid "Other (OpenAI-compatible)"
msgstr "Inny (zgodny z OpenAI)"

msgid "Model"
msgstr "Model"

msgid "The model's name as the provider lists it. Empty: {model}."
msgstr "Nazwa modelu podana przez dostawcę. Puste: {model}."

msgid "The model's name as the provider lists it."
msgstr "Nazwa modelu podana przez dostawcę."

msgid "API Key"
msgstr "Klucz API"

msgid "From the provider's developer console. It is kept in the editor's settings on this computer."
msgstr "Z konsoli deweloperskiej dostawcy. Jest przechowywany w ustawieniach edytora na tym komputerze."

msgid "API Address"
msgstr "Adres API"

msgid "Empty: the provider's own address. Needed for Other."
msgstr "Puste: własny adres dostawcy. Wymagany dla „Inny”."
